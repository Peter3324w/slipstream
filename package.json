{
  "name": "slipstream",
  "version": "0.1.0",
  "description": "A lightweight desktop Twitch client",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:mobile": "npm run ionic:build && cap sync android",
    "apk": "npm run build:mobile && cd android && gradlew.bat assembleDebug",
    "ionic:serve": "vite -c vite.mobile.config.ts",
    "ionic:build": "tsc --noEmit -p tsconfig.mobile.json && vite build -c vite.mobile.config.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "hls.js": "^1.7.3",
    "liquid-glass-react": "1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": "Peter3324w"
}
