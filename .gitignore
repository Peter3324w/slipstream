# secrets — never commit a Twitch client id, token or device code
.env
.env.*
!.env.example
*.token
secrets.json

# dependencies / build
node_modules/
dist/
out/
release/
# NOT build/ — that is electron-builder's buildResources, i.e. the app icon.
# It is a source asset; ignoring it means a fresh clone packages with Electron's
# default icon and nobody notices until someone looks at the taskbar.
*.tsbuildinfo

# streamlink/mpv runtime artefacts
cache/
recordings/
*.mp4
*.mkv
mpv-cache*
*.log

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
